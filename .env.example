# Copy to ".env" and fill with your Supabase project credentials.
# IMPORTANT: use the SAME Supabase project as PollTap — FeeTap reads the
# shared `votes` / `responses` tables to forecast the club's fixed roster.
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — canonical site origin used for Open Graph URLs.
# Defaults to https://feetap.vercel.app when unset.
# NEXT_PUBLIC_SITE_URL=https://feetap.vercel.app
